      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dataco-pg"
      },
      "description": "(previsto − real) / real. Positivo: previu a mais (estoque parado). Negativo: previu a menos (ruptura).",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4

          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT ROUND(((SUM(demanda_prevista) - SUM(demanda_real)) / NULLIF(SUM(demanda_real), 0) * 100)::numeric, 1) AS \"Diferença\" FROM previsoes WHERE data_corte = '$corte'"

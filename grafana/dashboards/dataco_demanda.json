          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT to_char(executado_em, 'YYYY-MM-DD HH24:MI') AS \"Executado em (UTC)\", data_corte::text AS \"Corte\", versao_candidata AS \"Candidato\", ROUND(rmse_candidato::numeric, 2) AS \"RMSE candidato\", ROUND(rmse_baseline::numeric, 2) AS \"RMSE baseline\", versao_champion AS \"Champion anterior\", ROUND(rmse_champion::numeric, 2) AS \"RMSE champion\", decisao AS \"Decisão\", motivo AS \"Motivo\" FROM decisoes_modelo ORDER BY executado_em DESC"

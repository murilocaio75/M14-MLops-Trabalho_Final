          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT semana::timestamp AS time, 'Previsto (corte ' || data_corte || ', v' || versao_modelo || ')' AS metric, SUM(demanda_prevista) AS value FROM previsoes GROUP BY 1, 2 ORDER BY 1"

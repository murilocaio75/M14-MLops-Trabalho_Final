          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT semana::timestamp AS time, SUM(demanda) AS \"Real\" FROM features_demanda_semanal GROUP BY 1 ORDER BY 1"
